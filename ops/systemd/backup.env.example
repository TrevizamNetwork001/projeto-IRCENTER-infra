# Sem secrets. Copiar para /etc/ircenter/backup.env com owner root e mode 0600.
BACKUP_ROOT=/var/backups/ircenter
BACKUP_TIER=daily
BACKUP_ENCRYPTION=none
BACKUP_STATUS_FILE=/var/lib/ircenter/backup-status.env
BACKUP_LOCK_FILE=/run/ircenter-backup/backup.lock

# Para operacao real, trocar BACKUP_ENCRYPTION para gpg e configurar somente o
# identificador publico abaixo. A chave privada deve permanecer fora do backup,
# guardada offline pelo operador (necessaria apenas para restaurar).
# GNUPGHOME=/var/backups/ircenter/.gnupg
# GPG_RECIPIENT=<fingerprint-operacional>

# Sincronizacao off-site (scripts/offsite-sync.sh), executada apos o backup
# via ExecStartPost em ircenter-backup.service. Config do rclone (com as
# credenciais do provedor S3-compativel) fica fora do git, em
# /etc/ircenter/rclone.conf, owner root:ircenter-backup, modo 0640.
# OFFSITE_REMOTE=r2:ircenter-backups
# OFFSITE_RETENTION_DAYS=90
