# Sem secrets. Copiar para /etc/ircenter/backup.env com owner root e mode 0600.
BACKUP_ROOT=/var/backups/ircenter
BACKUP_TIER=daily
BACKUP_ENCRYPTION=none
BACKUP_STATUS_FILE=/var/lib/ircenter/backup-status.env
BACKUP_LOCK_FILE=/run/ircenter-backup/backup.lock

# Para operacao real, trocar BACKUP_ENCRYPTION para gpg e configurar somente o
# identificador publico abaixo. A chave privada deve permanecer fora do backup.
# GPG_RECIPIENT=<fingerprint-operacional>
