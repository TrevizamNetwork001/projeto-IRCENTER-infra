FROM php:8.4.23-fpm-bookworm@sha256:c5fb7a0c02f4efe280691910c8b734995fa83598cdcf3115ef5dcb2e4617681c AS build

ARG APPLICATION
ENV DEBIAN_FRONTEND=noninteractive COMPOSER_ALLOW_SUPERUSER=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends git libcurl4-openssl-dev \
        libicu-dev libpq-dev libzip-dev unzip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && docker-php-ext-install -j"$(nproc)" bcmath curl intl opcache pcntl pdo_pgsql zip \
    && rm -rf /var/lib/apt/lists/* /tmp/pear

COPY --from=composer:2.10.2@sha256:4d71c3c2109c61d5415544264b59ad4087e4c5b7244481723664138fd36d5040 /usr/bin/composer /usr/local/bin/composer
WORKDIR /build/application
COPY ${APPLICATION}/composer.json ${APPLICATION}/composer.lock ./
RUN composer install --no-dev --prefer-dist --no-interaction --no-progress \
    --no-scripts --optimize-autoloader
COPY ${APPLICATION}/ ./

FROM php:8.4.23-fpm-bookworm@sha256:c5fb7a0c02f4efe280691910c8b734995fa83598cdcf3115ef5dcb2e4617681c AS runtime

ARG APP_DEST
ARG GIT_COMMIT=unknown
ARG RELEASE_VERSION=unreleased
ARG BUILD_DATE=unknown
ARG REPOSITORY=unknown
ARG SOURCE_TREE_DIGEST=unknown

LABEL org.opencontainers.image.revision=$GIT_COMMIT \
      org.opencontainers.image.version=$RELEASE_VERSION \
      org.opencontainers.image.created=$BUILD_DATE \
      org.opencontainers.image.source=$REPOSITORY \
      com.ircenter.source-tree.sha256=$SOURCE_TREE_DIGEST

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get purge -y --auto-remove $PHPIZE_DEPS curl libc6-dev linux-libc-dev \
    && apt-get install -y --no-install-recommends ca-certificates libfcgi-bin \
        libcurl4 libicu72 libpq5 libzip4 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /usr/local/include/php /usr/src/php* \
    && rm -f /usr/local/bin/docker-php-ext-* /usr/local/bin/php-config /usr/local/bin/phpize

COPY --from=build /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=build /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/
COPY docker/php/production.ini /usr/local/etc/php/conf.d/zz-ircenter-production.ini
COPY docker/php/health-fpm.conf /usr/local/etc/php-fpm.d/zz-ircenter-health.conf
COPY docker/health/heartbeat-write.sh /usr/local/bin/ircenter-heartbeat-write
COPY docker/health/php-fpm-healthcheck.sh /usr/local/bin/ircenter-php-fpm-healthcheck
COPY docker/health/heartbeat-healthcheck.sh /usr/local/bin/ircenter-heartbeat-healthcheck
COPY docker/health/queue-run.sh /usr/local/bin/ircenter-queue-run
COPY docker/health/scheduler-run.sh /usr/local/bin/ircenter-scheduler-run
COPY docker/php/runtime-entrypoint.sh /usr/local/bin/ircenter-runtime-entrypoint
COPY docker/php/normalize-compiled-views.sh /usr/local/bin/ircenter-normalize-compiled-views
COPY --from=build /build/application/ ${APP_DEST}/

RUN chmod 0555 /usr/local/bin/ircenter-* \
    && find "$APP_DEST" -xdev -type d -exec chmod 0755 {} + \
    && find "$APP_DEST" -xdev -type f -exec chmod 0644 {} + \
    && chmod 0755 "$APP_DEST/artisan" \
    && install -d -o www-data -g www-data -m 0750 \
        "$APP_DEST/storage" "$APP_DEST/storage/app" \
        "$APP_DEST/storage/app/private" "$APP_DEST/storage/app/public" \
        "$APP_DEST/storage/framework" "$APP_DEST/storage/framework/cache" \
        "$APP_DEST/storage/framework/cache/data" "$APP_DEST/storage/framework/sessions" \
        "$APP_DEST/storage/framework/testing" "$APP_DEST/storage/framework/views" \
        "$APP_DEST/storage/logs" "$APP_DEST/bootstrap/cache" \
    && printf '{"repository":"%s","commit":"%s","version":"%s","build_date":"%s","source_tree_sha256":"%s"}\n' \
        "$REPOSITORY" "$GIT_COMMIT" "$RELEASE_VERSION" "$BUILD_DATE" "$SOURCE_TREE_DIGEST" \
        > /app-release.json \
    && chmod 0444 /app-release.json

WORKDIR ${APP_DEST}
USER www-data
ENTRYPOINT ["/usr/local/bin/ircenter-runtime-entrypoint"]
CMD ["php-fpm"]
