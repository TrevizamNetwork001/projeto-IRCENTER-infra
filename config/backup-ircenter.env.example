# Exemplo sem credenciais; carregar valores operacionais por mecanismo protegido.
BACKUP_ROOT=/var/backups/ircenter
BACKUP_ALLOWED_ROOT=/var/backups
BACKUP_TIER=daily
BACKUP_ENCRYPTION=age
AGE_RECIPIENTS_FILE=/etc/ircenter/backup-age-recipients.txt
APP_DATABASE=ircenter_app
DOCUMENTATION_DATABASE=ircenter_documentation
RETENTION_DAILY_DAYS=14
RETENTION_WEEKLY_DAYS=90
RETENTION_MONTHLY_DAYS=730

# Use PGHOST/PGPORT/PGUSER e PGPASSFILE externo modo 0600, Docker secrets
# ou injecao pelo supervisor. Nunca coloque credencial neste template.
